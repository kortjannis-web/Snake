{
  "name": "snake-endlos",
  "private": true,
  "version": "1.49.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run --testTimeout=30000",
    "icons": "node scripts/icons.mjs",
    "android": "npm run build && npx cap sync android",
    "server": "wrangler dev --config server/wrangler.toml",
    "server:deploy": "wrangler deploy --config server/wrangler.toml",
    "vapid": "node scripts/vapid.mjs",
    "skin-videos": "node scripts/skin-videos.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@supabase/supabase-js": "^2.118.0",
    "lucide": "1.48.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@cloudflare/workers-types": "^5.20261018.1",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.0.18",
    "wrangler": "^4.151.1"
  }
}
